7. Supplier Ranking by Products Sold 
-- =====================================================
-- BUSINESS QUESTION:
-- Which suppliers have the highest number of distinct
-- products associated with sales transactions?
--
-- SKILLS:
-- JOIN, COUNT, DISTINCT, GROUP BY, ORDER BY
-- =====================================================
SELECT
s.CompanyName AS "Supplier",
COUNT(DISTINCT p.ProductID) AS "Products"
FROM Suppliers s
JOIN Products p
	ON s.SupplierID = p.SupplierID
JOIN "Order Details" od
	ON p.ProductID = od.ProductID
GROUP BY s.SupplierID
ORDER BY COUNT(DISTINCT p.ProductID) DESC;
